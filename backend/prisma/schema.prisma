generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// the Admin will simply have an Edit College Information page where these can be edited.

model CollegeSettings {
  id            Int      @id @default(autoincrement())

  tpoHeadName   String
  tpoHeadPhoto  String?
  tpoHeadEmail  String
  tpoHeadPhone  String

  officeAddress String?
  officeHours   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// user for signup/login
enum Role {
  STUDENT
  ADMIN
  CO_ADMIN
}

enum Course {
  BTECH
  MTECH
  MBA
  MCA
}

enum PlacementStatus {
  PLACED
  NOT_PLACED
}

enum ProfileStatus {
  INCOMPLETE
  COMPLETE
}

model User {
  id             Int      @id @default(autoincrement())
  fullName        String
  collegeEmail   String   @unique
  password       String

  role           Role     @default(STUDENT)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studentProfile StudentProfile?
}

model StudentProfile {
  userId                Int      @id

  course                Course

  department            String?

  admissionYear         Int
  graduationYear        Int

  currentYear           Int
  currentSemester       Int

  collegeId             String   @unique
  btuRollNumber         String  @unique
  enrollmentNumber      String  @unique

  dob                   DateTime
  gender                String

  phoneNumber           String   @unique
  whatsappNumber        String
  alternatePhone        String?
  alternateEmail        String?

  currentAddress        String
  permanentAddress      String

  nativeCity            String
  nativeDistrict        String
  nativeState           String

  aadharNumber          String   @unique
  panNumber             String?  @unique

  tenthPercentage       Decimal
  tenthYear             Int
  tenthBoard            String

  twelfthPercentage     Decimal
  twelfthYear           Int
  twelfthBoard          String

  diplomaPercentage     Decimal?
  diplomaYear           Int?

  cgpa                  Decimal

  activeBacklogs        Int
  passiveBacklogs       Int

  linkedinUrl           String?

  placementStatus       PlacementStatus @default(NOT_PLACED)
  profileStatus         ProfileStatus   @default(INCOMPLETE)

  isVerified            Boolean @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)


  semesterResults SemesterResult[]

  document Document?
}

model SemesterResult {
  userId    Int
  semester  Int
  sgpa      Decimal

 profile StudentProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, semester])
}

model Document {
  userId      Int @id

  resumeUrl   String

  uploadedAt  DateTime @default(now())

profile StudentProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model EmailVerification {
  collegeEmail String   @id
  otp          String?
  expiresAt    DateTime
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
}